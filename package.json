{
	"name": "@blackswampai/emdash-plugin-medusa",
	"version": "0.1.0",
	"description": "Native EmDash CMS plugin for live Medusa v2 product references",
	"keywords": [
		"astro",
		"commerce",
		"emdash",
		"emdash-plugin",
		"medusa",
		"portable-text"
	],
	"homepage": "https://github.com/BlackSwampAI/emdash-plugin-medusa#readme",
	"bugs": {
		"url": "https://github.com/BlackSwampAI/emdash-plugin-medusa/issues"
	},
	"license": "MIT",
	"author": "Black Swamp AI",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/BlackSwampAI/emdash-plugin-medusa.git"
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"LICENSE",
		"docs/architecture.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./admin": "./src/admin/index.tsx",
		"./astro": "./src/astro/index.ts",
		"./client": {
			"types": "./dist/medusa/client.d.mts",
			"import": "./dist/medusa/client.mjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --deny-warnings",
		"format": "oxfmt --ignore-path .gitignore && prettier --write 'src/**/*.astro' 'dev/**/*.astro'",
		"format:check": "oxfmt --ignore-path .gitignore --check && prettier --check 'src/**/*.astro' 'dev/**/*.astro'",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm package:check && pnpm package:consumer",
		"package:check": "node scripts/check-package.mjs",
		"package:consumer": "node scripts/check-consumer.mjs",
		"dev:up": "node scripts/dev.mjs up",
		"dev:down": "node scripts/dev.mjs down",
		"dev:site": "astro dev --ignore-lock --root dev/site",
		"dev:tunnel": "node scripts/dev-tunnel.mjs",
		"test:e2e": "node scripts/e2e.mjs",
		"prepublishOnly": "pnpm check",
		"dev:configure": "node scripts/dev-configure.mjs"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.8",
		"@astrojs/node": "11.1.6",
		"@astrojs/react": "7.0.0",
		"@cloudflare/kumo": "2.14.0",
		"@types/node": "24.10.1",
		"@types/react": "19.3.0",
		"astro": "7.3.5",
		"emdash": "1.0.1",
		"kysely": "0.28.13",
		"oxfmt": "0.59.0",
		"oxlint": "1.74.0",
		"playwright": "1.61.1",
		"prettier": "3.9.5",
		"prettier-plugin-astro": "0.14.1",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"tsdown": "0.20.3",
		"typescript": "5.9.3",
		"vitest": "4.1.10"
	},
	"peerDependencies": {
		"@cloudflare/kumo": "^2",
		"astro": ">=7 <8",
		"emdash": ">=1.0.1 <2",
		"react": "^19"
	},
	"engines": {
		"node": ">=22.16"
	},
	"packageManager": "pnpm@10.32.1"
}
